<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="service" source="spring.application.name" defaultValue="app"/>

  <!-- local: human readable -->
  <springProfile name="!json">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level [${service}] [%X{correlationId:-}] %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
  </springProfile>

  <!-- docker / k8s: one JSON object per line (ELK / CloudWatch Logs Insights friendly) -->
  <springProfile name="json">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"${service}"}</customFields>
        <includeMdcKeyName>correlationId</includeMdcKeyName>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
</configuration>
